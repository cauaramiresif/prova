<%- include('cabecalho.ejs')%>
<main class="container">
        <a href="/filme" class="back-link">← Voltar para lista</a>

        <div class="form-container">
            <h2>Cadastrar Novo Filme</h2>
            
            <form method="post" >
                <div class="form-group">
                    <label for="nome">Título do Filme *</label>
                    <input 
                        type="text" 
                        id="titulo" 
                        name="titulo" 
                        
                    >
                </div>

                <div class="form-group">
                    <label for="pais">Duração *</label>
                    <input 
                        type="number" 
                        id="duracao" 
                        name="duracao" 
                       
                    >
                </div>

                <div class="form-group">
                    <label for="anoinicio">Classificação Indicativa *</label>
                    <input 
                        type="number" 
                        id="classificacao_indicativa" 
                        name="classificacao_indicativa" 
                        
                    >
                </div>

                <div class="form-group">
                    <label for="anoinicio">Ano de Lançamento *</label>
                    <input 
                        type="number" 
                        id="ano" 
                        name="ano" 
                        
                    >
                </div>

                <div class="form-group">
                    <label for="anoinicio">Gênero *</label>
                    <input 
                        type="text" 
                        id="genero" 
                        name="genero" 
                        
                    >
                </div>

                <div class="form-buttons">
                    <button type="submit" class="btn btn-success">Cadastrar</button>
                    <a href="/filme" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </main>
<%- include('rodape.ejs')%>