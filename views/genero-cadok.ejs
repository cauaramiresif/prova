<%- include('cabecalho.ejs')%>

    <!-- Conteúdo Principal -->
    <main class="container">
        <div class="success-container">
            <div class="success-icon">✓</div>
            <h2>Cadastrado com Sucesso!</h2>
            <p class="success-message">O Gênero foi cadastrado no sistema.</p>

            <div class="detail-box">
                <h3>Dados Cadastrados</h3>
                
                <div class="detail-item">
                    <label>Nome:</label>
                    <p id="display-nome"><%=nome%></p>
                </div>
                
                <div class="detail-item">
                    <label>Descrição:</label>
                    <p id="display-pais"><%=descricao%></p>
                </div>
            </div>

            <div class="success-buttons">
                <a href="/genero/cadastro" class="btn btn-success">Cadastrar Outro Gênero</a>
                <a href="/genero" class="btn btn-primary">Ver Lista de Gêneros</a>
                <a href="/" class="btn btn-secondary">Voltar ao Início</a>
            </div>
        </div>
    </main>
<%- include('rodape.ejs')%>