<%- include('cabecalho.ejs')%>

    <!-- Conteúdo Principal -->
    <main class="container">
        <div class="success-container">
            <div class="success-icon">✓</div>
            <h2>Cadastrado com Sucesso!</h2>
            <p class="success-message">O filme foi cadastrado no sistema.</p>

            <div class="detail-box">
                <h3>Dados Cadastrados</h3>
                
                <div class="detail-item">
                    <label>Título:</label>
                    <p id="display-nome"><%=titulo%></p>
                </div>
                
                <div class="detail-item">
                    <label>Duração:</label>
                    <p id="display-pais"><%=duracao%> minutos</p>
                </div>
                
                <div class="detail-item">
                    <label>Classificação Indicativa:</label>
                    <p id="display-ano">A<%=classificacao_indicativa%></p>
                </div>

                <div class="detail-item">
                    <label>Ano de Estreia:</label>
                    <p id="display-ano"><%=ano%></p>
                </div>

                <div class="detail-item">
                    <label>Gênero:</label>
                    <p id="display-ano"><%=genero%></p>
                </div>
            </div>

            <div class="success-buttons">
                <a href="/filme/cadastro" class="btn btn-success">Cadastrar Outro Filme</a>
                <a href="/filme" class="btn btn-primary">Ver Lista de Filmes</a>
                <a href="/" class="btn btn-secondary">Voltar ao Início</a>
            </div>
        </div>
    </main>
<%- include('rodape.ejs')%>